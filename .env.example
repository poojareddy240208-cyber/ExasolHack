# ==============================================================================
# OmniSync Environment Configuration Example
# Copy this file to .env before starting the services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (Transactional OLTP - OCC Ledgers, Catalog, Fast Reads)
# ------------------------------------------------------------------------------
POSTGRES_USER=omnisync
POSTGRES_PASSWORD=omnisync_secret
POSTGRES_DB=omnisync_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://omnisync:omnisync_secret@postgres:5432/omnisync_db
POSTGRES_SYNC_URL=postgresql://omnisync:omnisync_secret@postgres:5432/omnisync_db

# ------------------------------------------------------------------------------
# Exasol Personal Edition (In-Memory Analytics OLAP - The Brain)
# Note: Exasol requires privileged mode in Docker and at least 8GB host RAM.
# ------------------------------------------------------------------------------
EXASOL_HOST=exasol
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=OMNISYNC_ANALYTICS
EXASOL_URL=exasol://sys:exasol@exasol:8563
EXASOL_BUCKETFS_PORT=2580
EXASOL_BUCKETFS_SERVICE=bfsdefault
EXASOL_BUCKETFS_BUCKET=models
EXASOL_BUCKETFS_PASSWORD=write_password

# ------------------------------------------------------------------------------
# Redis (In-Memory Event Cache & Celery Broker)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Celery Message Broker & Result Backend
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# Security & Third-Party Webhook Integrations
# ------------------------------------------------------------------------------
ZENDESK_WEBHOOK_SECRET=sk_live_zendesk_webhook_secret_placeholder_9482736
API_SECRET_KEY=omnisync_super_secret_jwt_and_session_signing_key_2026

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_SERVER_PORT=8501
BACKEND_API_BASE_URL=http://api:8000
